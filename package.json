{
  "name": "mba-hub-v2",
  "version": "2.0.0-alpha.7",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/build.mjs --check",
    "serve": "python3 -m http.server 8080 --directory dist/developer",
